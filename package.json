{
  "name": "kizashi-ephemeris",
  "version": "1.0.0",
  "description": "The astronomical calculation Worker behind Kizashi (Swiss Ephemeris, Moshier mode).",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    "./sky": "./src/sky.ts",
    "./ephemeris": "./src/ephemeris.ts",
    "./calendar": "./src/calendar.ts",
    "./features": "./src/features.ts",
    "./perfections": "./src/perfections.ts",
    "./weekly-sky": "./src/weekly-sky.ts"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "types": "node scripts/worker-cli.mjs types",
    "build:source": "node scripts/build-source.mjs",
    "predeploy": "npm run build:source",
    "deploy": "node scripts/worker-cli.mjs deploy",
    "check:worker": "npm run build:source && node scripts/worker-cli.mjs deploy --dry-run --outdir dist/worker"
  },
  "dependencies": {
    "@typescriptify/sweph": "1.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@kuntay/swisseph": "0.2.2",
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  }
}
