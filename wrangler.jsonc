{
  // The calculation Worker. It has no public route of its own: Kizashi's Worker calls it over a
  // service binding (class Ephemeris). Its source is this repository on GitHub.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kizashi-ephemeris",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "workers_dev": false,
  // The best-births search (kizashi-lucky, once a day) takes seconds of CPU; requests from kizashi take milliseconds.
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
