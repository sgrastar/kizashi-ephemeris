{
  // The calculation Worker. It has no public route of its own: Kizashi's Worker calls it over a
  // service binding (class Ephemeris) and forwards /source/ to it.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kizashi-ephemeris",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "workers_dev": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
